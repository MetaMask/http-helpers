{
  "name": "@toruslabs/http-helpers",
  "version": "10.0.0",
  "description": "http helpers",
  "sideEffects": false,
  "main": "dist/lib.cjs/index.js",
  "module": "dist/lib.esm/index.js",
  "unpkg": "dist/lib.esm/index.js",
  "jsdelivr": "dist/lib.esm/index.js",
  "types": "dist/lib.cjs/index.d.ts",
  "scripts": {
    "build": "vp pack",
    "prepack": "npm run build",
    "lint": "vp lint",
    "check": "vp check",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:node && npm run test:browsers",
    "test:node": "vp test run --config test/configs/node.config.mts --coverage",
    "test:browsers": "vp test run --config test/configs/browsers.config.mts --coverage",
    "prepare": "husky",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only --ignore-scripts",
    "release-packages": "changeset publish"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@sentry/core": "^10.x"
  },
  "peerDependenciesMeta": {
    "@sentry/core": {
      "optional": true
    }
  },
  "dependencies": {
    "@fastify/deepmerge": "^3.2.4",
    "loglevel": "^1.9.2"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@lavamoat/harden": "^0.8.1",
    "@sentry/core": "^10.36.0",
    "@toruslabs/config": "^5.0.0",
    "@toruslabs/oxlint-config-typescript": "^1.0.0",
    "@toruslabs/torus-scripts": "^9.0.1",
    "@types/node": "^26.6.6",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-istanbul": "5.0.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "playwright": "^1.57.0",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "^1.4.0",
    "vitest": "5.0.5",
    "vitest-fetch-mock": "^0.4.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/torusresearch/http-helpers.git"
  },
  "keywords": [
    "torus"
  ],
  "author": "Torus Labs",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/torusresearch/http-helpers/issues"
  },
  "homepage": "https://github.com/torusresearch/http-helpers#readme",
  "lint-staged": {
    "!(*d).{js,ts,mjs,mts}": [
      "vp fmt",
      "vp lint --fix"
    ],
    "!(package-lock).{json,md}": [
      "vp fmt"
    ]
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24.22.0",
    "npm": ">=12"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.17.0",
      "onFail": "error"
    }
  },
  "allowScripts": {
    "fsevents@2.3.3": false
  }
}
